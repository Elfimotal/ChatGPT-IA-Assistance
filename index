<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChatGPT</title>
  
  <!-- FAVICON DE L'ONGLET -->
  <link rel="icon" type="image/png" href="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg">
  <!-- Tailwind CSS & FontAwesome -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #212121; color: #ececec; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-thumb { background: #424242; border-radius: 10px; }
    .prose p { margin-bottom: 0.75rem; line-height: 1.6; }
    .prose pre { background: #0d0d0d; border: 1px solid #333; padding: 1rem; border-radius: 0.75rem; overflow-x: auto; color: #38bdf8; }
  </style>
</head>
<body class="h-screen flex overflow-hidden bg-[#212121]">
  <!-- SIDEBAR -->
  <aside id="sidebar" class="w-64 bg-[#171717] border-r border-white/5 flex flex-col justify-between h-full transition-all duration-300 shrink-0">
    <div class="p-3 space-y-3">
      <div class="flex items-center justify-between">
        <button onclick="clearChat()" class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-white/10 text-white font-medium text-sm transition border border-white/10 bg-[#212121]">
          <span class="flex items-center gap-2.5">
            <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" class="w-5 h-5 filter invert" alt="ChatGPT Logo">
            <span>Nouvelle discussion</span>
          </span>
          <i class="fa-regular fa-pen-to-square text-xs text-gray-400"></i>
        </button>
      </div>
      <div class="pt-2">
        <div class="text-[11px] font-semibold text-gray-400 mb-2 px-2">Aujourd'hui</div>
        <div class="space-y-1 text-sm">
          <div class="px-3 py-2 rounded-lg bg-white/10 text-white font-medium truncate cursor-pointer flex items-center gap-2">
            <i class="fa-regular fa-message text-xs text-gray-400"></i>
            Application ChatGPT
          </div>
        </div>
      </div>
    </div>
    <!-- Profil -->
    <div class="p-3 border-t border-white/5 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-emerald-600 flex items-center justify-center font-bold text-white text-xs">
          N
        </div>
        <span class="text-sm font-medium text-white">Nicolas Bigras</span>
      </div>
    </div>
  </aside>
  <!-- ZONE PRINCIPALE -->
  <div class="flex-1 flex flex-col h-full bg-[#212121]">
    
    <!-- En-tête -->
    <header class="flex items-center justify-between px-4 py-3 border-b border-white/5">
      <div class="flex items-center gap-3">
        <button onclick="toggleSidebar()" class="text-gray-400 hover:text-white p-1">
          <i class="fa-solid fa-bars"></i>
        </button>
        <div class="flex items-center gap-2">
          <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" class="w-6 h-6 filter invert" alt="ChatGPT Logo">
          <span class="font-bold text-lg text-white tracking-tight">ChatGPT <span class="text-xs text-gray-400 font-normal">4o</span></span>
        </div>
      </div>
      <button onclick="clearChat()" class="text-xs text-gray-400 hover:text-white bg-white/5 px-3 py-1.5 rounded-lg border border-white/10 transition">
        Effacer
      </button>
    </header>
    <!-- Chat -->
    <main id="chatWindow" class="flex-1 overflow-y-auto px-4 py-6 max-w-3xl mx-auto w-full space-y-6">
      <div id="welcomeMessage" class="flex flex-col items-center justify-center h-full text-center py-16">
        <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mb-4 p-2 shadow-lg">
          <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" class="w-8 h-8 filter invert" alt="ChatGPT Logo">
        </div>
        <h1 class="text-2xl font-semibold text-white tracking-tight">Comment puis-je vous aider aujourd'hui ?</h1>
      </div>
    </main>
    <!-- Zone de texte -->
    <footer class="p-4 bg-[#212121]">
      <div class="max-w-3xl mx-auto">
        <form id="chatForm" onsubmit="handleSubmit(event)" class="flex items-center bg-[#2f2f2f] rounded-3xl border border-white/10 focus-within:border-gray-400 p-2 pl-4 transition shadow-xl">
          <textarea id="userInput" rows="1" placeholder="Envoyer un message à ChatGPT..." 
            class="w-full bg-transparent text-white placeholder-gray-400 focus:outline-none resize-none max-h-32 text-sm leading-relaxed"
            onkeydown="handleKeyDown(event)"></textarea>
          <button type="submit" class="bg-white text-black hover:bg-gray-200 w-8 h-8 rounded-full flex items-center justify-center shrink-0 ml-2 transition">
            <i class="fa-solid fa-arrow-up text-xs"></i>
          </button>
        </form>
        <p class="text-[11px] text-center text-gray-500 mt-2">ChatGPT peut commettre des erreurs. Vérifiez les informations importantes.</p>
      </div>
    </footer>
  </div>
  <script>
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('-ml-64');
    }
    function handleKeyDown(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleSubmit(e);
      }
    }
    function clearChat() {
      document.getElementById('chatWindow').innerHTML = `
        <div id="welcomeMessage" class="flex flex-col items-center justify-center h-full text-center py-16">
          <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mb-4 p-2 shadow-lg">
            <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" class="w-8 h-8 filter invert" alt="ChatGPT Logo">
          </div>
          <h1 class="text-2xl font-semibold text-white tracking-tight">Comment puis-je vous aider aujourd'hui ?</h1>
        </div>`;
    }
    async function handleSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('userInput');
      const text = input.value.trim();
      if (!text) return;
      const welcome = document.getElementById('welcomeMessage');
      if (welcome) welcome.remove();
      appendUserMessage(text);
      input.value = '';
      const lower = text.toLowerCase();
      const isImage = lower.includes('image') || lower.includes('dessine') || lower.includes('génère') || lower.includes('draw');
      if (isImage) {
        appendImageMessage(text);
      } else {
        const loadingId = appendLoading();
        try {
          const systemPrompt = "Tu es ChatGPT, un assistant IA développé par OpenAI. Réponds précisément en français.";
          const response = await fetch(`https://text.pollinations.ai/${encodeURIComponent(text)}?system=${encodeURIComponent(systemPrompt)}&model=openai`);
          const reply = await response.text();
          
          removeMessage(loadingId);
          appendAssistantMessage(reply);
        } catch (err) {
          removeMessage(loadingId);
          appendAssistantMessage("⚠️ Erreur lors de la génération de la réponse.");
        }
      }
    }
    function appendUserMessage(text) {
      const chatWindow = document.getElementById('chatWindow');
      const div = document.createElement('div');
      div.className = 'flex justify-end';
      div.innerHTML = <div class="bg-[#2f2f2f] text-gray-100 px-4 py-2.5 rounded-2xl max-w-[85%] text-sm">${escapeHtml(text)}</div>;
      chatWindow.appendChild(div);
      chatWindow.scrollTop = chatWindow.scrollHeight;
    }
    function appendAssistantMessage(fullText) {
      const chatWindow = document.getElementById('chatWindow');
      const div = document.createElement('div');
      div.className = 'flex gap-3 justify-start';
      
      const contentId = 'msg-' + Date.now();
      div.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-[#10a37f] flex items-center justify-center shrink-0 p-1">
          <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" class="w-4 h-4 filter invert" alt="AI">
        </div>
        <div id="${contentId}" class="prose prose-invert max-w-[85%] text-sm leading-relaxed"></div>`;
      
      chatWindow.appendChild(div);
      let i = 0;
      const target = document.getElementById(contentId);
      function type() {
        if (i < fullText.length) {
          i += Math.min(5, fullText.length - i);
          target.innerHTML = marked.parse(fullText.substring(0, i));
          chatWindow.scrollTop = chatWindow.scrollHeight;
          setTimeout(type, 8);
        }
      }
      type();
    }
    function appendImageMessage(prompt) {
      const chatWindow = document.getElementById('chatWindow');
      const imageUrl = https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=1024&height=1024&nologo=true&seed=${Math.floor(Math.random() * 999999)};
      
      const div = document.createElement('div');
      div.className = 'flex gap-3 justify-start';
      div.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-[#10a37f] flex items-center justify-center shrink-0 p-1">
          <img src="https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg" class="w-4 h-4 filter invert" alt="AI">
        </div>
        <div class="max-w-[85%] space-y-2">
          <p class="text-xs text-gray-400">Image générée : "${escapeHtml(prompt)}":</p>
          <img src="${imageUrl}" class="rounded-xl max-w-sm w-full h-auto border border-white/10 shadow-lg" loading="lazy" />
        </div>`;
      chatWindow.appendChild(div);
      chatWindow.scrollTop = chatWindow.scrollHeight;
    }
    function appendLoading() {
      const chatWindow = document.getElementById('chatWindow');
      const id = 'loading-' + Date.now();
      const div = document.createElement('div');
      div.id = id;
      div.className = 'flex gap-3 items-center';
      div.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-[#10a37f]/20 text-[#10a37f] flex items-center justify-center shrink-0 text-xs">
          <i class="fa-solid fa-spinner fa-spin"></i>
        </div>
        <span class="text-xs text-gray-400">Génération de la réponse...</span>`;
      chatWindow.appendChild(div);
      chatWindow.scrollTop = chatWindow.scrollHeight;
      return id;
    }
    function removeMessage(id) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }
    function escapeHtml(text) {
      return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
  </script>
</body>
</html>
